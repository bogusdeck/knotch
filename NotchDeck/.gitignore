# .gitignore for NotchDeck

# ── Xcode ──────────────────────────────────────────────────────────────────
# Generated by XcodeGen — do NOT commit
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-to-trash.mode1v3

# ── Swift Package Manager ──────────────────────────────────────────────────
.build/
.swiftpm/
# Keep Package.resolved for reproducible builds
!Package.resolved

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
__MACOSX/

# ── Editor ─────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/

# ── Test / Coverage ────────────────────────────────────────────────────────
*.gcda
*.gcno
coverage/
.lcov

# ── Signing / Distribution ────────────────────────────────────────────────
*.p12
*.cer
*.mobileprovision
*.provisionprofile
ExportOptions.plist

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
